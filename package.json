{
  "name": "egov4schools",
  "version": "0.1.0",
  "description": "Compară rezultatele bacalaureatului pentru liceele din Republica Moldova, folosind datele publice MEC/ANCE și Modelul Unitar de Design.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "mud:types": "node scripts/generate-mud-jsx.mjs",
    "api": "tsx watch server/index.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:rollback": "tsx server/db/cli.ts rollback",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:reset": "tsx server/db/cli.ts reset",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@egov-moldova/mud": "^1.1.9",
    "@tanstack/react-query": "^5.102.8",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": [
      "prettier --write"
    ]
  }
}
